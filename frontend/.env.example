# Copy to frontend/.env.local for local development; add the same names in Vercel for production.
DATABASE_URL=postgres://...neon.tech/neondb?sslmode=require   # the app's limited role, trngprgm_app
DATABASE_OWNER_URL=           # local only, never on Vercel: the owner role, used by database/migrate.ts
ADMIN_KEY=                    # unlocks the Settings page and encrypts keys saved there (long and random)

# Optional here: these can instead be set on the Settings page (they win over these values).
ACCESS_KEY=                   # pre-shared sign-in key for clerks (long and random)
GOOGLE_SERVICE_ACCOUNT_KEY=   # the service account's JSON key file contents, on one line
GOOGLE_CALENDAR_OWNER=        # your Google account; gets owner access to calendars the app creates
OPENAI_API_KEY=

# Tests / offline development only: point at fake servers (see docs/developer-guide.md).
# GOOGLE_API_ROOT=http://localhost:4010/
# OPENAI_BASE_URL=http://localhost:4011
