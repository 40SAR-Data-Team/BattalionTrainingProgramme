{
  "name": "trngprgm",
  "private": true,
  "workspaces": ["frontend", "backend", "shared", "tests"],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "start": "bun run --cwd frontend start",
    "lint": "bun run --cwd frontend lint && tsc --noEmit -p .",
    "test": "bun run --cwd tests test",
    "test:fast": "bun run --cwd tests test:fast",
    "test:e2e": "bun run --cwd tests e2e",
    "db:migrate": "bun database/migrate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
